PORT=3210

# Maintenance-only token. Public Site Tester, Malware Scanner and approved Preview
# sessions do NOT require this token. It protects forced refresh/sweep endpoints only.
ADMIN_TOKEN=change-me-now

# Proxy discovery / checking
SOURCE_REFRESH_MS=300000
SOURCE_FETCH_TIMEOUT_MS=25000
MAX_SOURCE_BYTES=33554432
HEALTHCHECK_INTERVAL_MS=60000
HEALTHCHECK_TIMEOUT_MS=7000
HEALTHCHECK_BATCH_SIZE=80
MAX_PROXIES=1500
HEALTHCHECK_URL=https://api.ipify.org?format=json

# Persistent SQLite database. The Docker volume already maps /app/data.
SQLITE_PATH=/app/data/nekoroute.sqlite

# Public UI/API
EXPOSE_NODE_ADDRESSES=false
TRUST_PROXY=false
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# Public availability tester. Requests are limited to HTTP/HTTPS on ports 80/443;
# private/reserved destinations are blocked.
MAX_TEST_RESPONSE_BYTES=262144
TEST_TIMEOUT_MS=10000
TEST_MATRIX_MAX_NODES=20
TEST_MATRIX_CONCURRENCY=4

# Optional trusted local/sidecar egress nodes. Separate multiple entries with ';'.
# Format: proxy-url|ISO2-country|city/label|source-name
# Example: socks5://gluetun:1080|GB|London|Gluetun
STATIC_PROXY_NODES=

# Safe rendered Preview remains operator-allowlisted so the deployment cannot become
# an unrestricted anonymous web relay. Subdomains are accepted automatically.
ALLOWED_TEST_HOSTS=example.com
PREVIEW_SESSION_TTL_MS=900000
PREVIEW_MAX_HTML_BYTES=2097152
PREVIEW_MAX_RESOURCE_BYTES=4194304

# Malware/domain scanner. Page content is fetched through the selected proxy and
# remote JavaScript is never executed.
SCAN_RATE_LIMIT_MAX=12
SCAN_TIMEOUT_MS=12000
SCAN_MAX_BYTES=1048576

# Optional reputation providers. Leave blank to use only NekoRoute local heuristics.
# VirusTotal API v3: existing report lookup only; NekoRoute does not automatically
# submit unknown URLs for a new scan.
VIRUSTOTAL_API_KEY=

# Google Web Risk Lookup API. Requires a Google Cloud Web Risk API key/billing setup.
GOOGLE_WEB_RISK_API_KEY=


# Optional local proxy gateway. The gateway uses only currently-online SOCKS5,
# HTTP and HTTPS nodes from NekoRoute's automatically refreshed proxy pool.
PROXY_GATEWAY_ENABLED=false
PROXY_GATEWAY_HOST=0.0.0.0
SOCKS5_GATEWAY_PORT=1080
HTTP_GATEWAY_PORT=8080
HTTPS_GATEWAY_PORT=8443
PROXY_GATEWAY_TIMEOUT_MS=12000
PROXY_GATEWAY_MAX_RETRIES=4

# Leave both blank for no client authentication. When set, clients use:
# socks5://user:pass@host:1080
# http://user:pass@host:8080
# https://user:pass@host:8443
PROXY_GATEWAY_USERNAME=
PROXY_GATEWAY_PASSWORD=

# Required only for the TLS-wrapped HTTPS proxy listener on port 8443.
# Mount these certificate/key files into the container.
PROXY_GATEWAY_TLS_CERT=
PROXY_GATEWAY_TLS_KEY=


# Exit-IP classification for healthy proxies
IP_LOOKUP_URL=https://api.nekosunevr.co.uk/v5/proxy/iplookup
IP_LOOKUP_TIMEOUT_MS=5000
IP_LOOKUP_TTL_MS=21600000


# Extra proxies supplied directly. Separate entries with semicolons, commas or newlines.
# Explicit schemes supported: http:// https:// socks4:// socks5://
MANUAL_PROXIES=http://127.0.0.1:3128;socks5://127.0.0.1:1080

# Extra remote text lists. Format each source as PROTOCOL|URL and separate sources
# with semicolons or newlines. Lines inside each downloaded list may be IP:PORT
# or full proxy URLs.
MANUAL_PROXY_LISTS=http|https://example.com/http.txt;https|https://example.com/https.txt;socks4|https://example.com/socks4.txt;socks5|https://example.com/socks5.txt
